		</Text>
		<Text name="n_taberna_a" id="9" order="9" lastModified="-1">
			<TextTextLanguages>
				<text Text="Taberna de la Grulla" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_taberna_b" id="10" order="10" lastModified="-1">
			<TextTextLanguages>
				<text Text="Taberna del Farol" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_pescador" id="11" order="11" lastModified="-1">
