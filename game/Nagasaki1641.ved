	<Scripts newId="1" versionedId="-1" tableId="30">
		<Script name="Cursor visible" id="0" order="0" lastModified="-1" ScriptScript="local cursorSprite = nil&lt;br/&gt;&lt;br/&gt;-- Autoavance de los diálogos: cada texto dura en pantalla según su longitud&lt;br/&gt;-- (y se puede saltar con un clic, como siempre).&lt;br/&gt;function nagasakiTextStarted(text)&lt;br/&gt;  local body = text and text.CurrentText or &quot;&quot;&lt;br/&gt;  if text then&lt;br/&gt;    local dur = 1300 + #body * 28&lt;br/&gt;    if dur &gt; 5200 then dur = 5200 end&lt;br/&gt;    if dur &lt; 1500 then dur = 1500 end&lt;br/&gt;    text.TimeToWait = dur&lt;br/&gt;  end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;registerEventHandler(&quot;textStarted&quot;, &quot;nagasakiTextStarted&quot;)&lt;br/&gt;&lt;br/&gt;function nagasakiCursor()&lt;br/&gt;  if not cursorSprite then&lt;br/&gt;    cursorSprite = graphics.loadFromFile(&quot;vispath:graphics/cursor_arrow.png&quot;)&lt;br/&gt;  end&lt;br/&gt;  if cursorSprite then&lt;br/&gt;    local p = getCursorPos()&lt;br/&gt;    cursorSprite.position = {x = p.x - 8, y = p.y - 6}&lt;br/&gt;    graphics.drawSprite(cursorSprite, 1.0)&lt;br/&gt;  end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;graphics.addDrawFunc(&quot;nagasakiCursor()&quot;, 1)&lt;br/&gt;&lt;br/&gt;-- ESC: abrir / cerrar el menú de pausa&lt;br/&gt;function nagasakiKeyHandler(eventType, character, keycode, modifiers)&lt;br/&gt;  if keycode == eKeyEscape and eventType == eEvtKeyDown then&lt;br/&gt;    local enMenu = Conditions[&quot;en_menu&quot;] and Conditions[&quot;en_menu&quot;].Value&lt;br/&gt;    if enMenu then return false end&lt;br/&gt;    local pv = Conditions[&quot;pausa&quot;] and Conditions[&quot;pausa&quot;].Value&lt;br/&gt;    if pv then&lt;br/&gt;      startAction(Actions[&quot;Cerrar pausa&quot;])&lt;br/&gt;    else&lt;br/&gt;      startAction(Actions[&quot;Abrir pausa&quot;])&lt;br/&gt;    end&lt;br/&gt;    return true&lt;br/&gt;  end&lt;br/&gt;  return false&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;registerEventHandler(&quot;keyEvent&quot;, &quot;nagasakiKeyHandler&quot;)" ScriptType="1" />
	</Scripts>
