		<Text name="foto" id="21" order="21" lastModified="-1">
			<TextTextLanguages>
				<text Text="Tu familia, retratada el año del incendio. Tu madre sostiene el abanico que aún guardas; tu padre finge no sonreír." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="nota" id="22" order="22" lastModified="-1">
			<TextTextLanguages>
				<text Text="«Haru: si lees esto, es que ya eres el hombre de la casa. Te quiero más de lo que supe decirte. Cuida el negocio y cuídate tú. — Tu padre»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="taberna_cerrada" id="23" order="23" lastModified="-1">
			<TextTextLanguages>
				<text Text="La puerta está cerrada con una cuerda y un cartel: «Cerrado hasta la noche»." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="taberna_abierta" id="24" order="24" lastModified="-1">
