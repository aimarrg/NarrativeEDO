	<Scripts newId="1" versionedId="-1" tableId="30">
		<Script name="Cursor visible" id="0" order="0" lastModified="-1" ScriptScript="local cursorSprite = nil&lt;br/&gt;&lt;br/&gt;local function logText(msg)&lt;br/&gt;  local f = io.open(&quot;C:/Temps/opencode/lua_text.log&quot;, &quot;a&quot;)&lt;br/&gt;  if f then&lt;br/&gt;    f:write(msg .. &quot;\n&quot;)&lt;br/&gt;    f:close()&lt;br/&gt;  end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;function nagasakiTextStarted(text)&lt;br/&gt;  local id = &quot;?&quot;&lt;br/&gt;  if text and text.getId then&lt;br/&gt;    local tid = text:getId()&lt;br/&gt;    if tid then id = tostring(tid.id) end&lt;br/&gt;  end&lt;br/&gt;  local body = text and text.CurrentText or &quot;&quot;&lt;br/&gt;  logText(string.format(&quot;%.2f textStarted id=%s len=%d current=%s&quot;, os.clock(), id, #body, body))&lt;br/&gt;  local names = {&quot;viendo_foto&quot;, &quot;tabernas_abiertas&quot;, &quot;hablo_pescador&quot;, &quot;pausa&quot;}&lt;br/&gt;  local parts = {}&lt;br/&gt;  for _, n in ipairs(names) do&lt;br/&gt;    local c = Conditions[n]&lt;br/&gt;    if c then parts[#parts + 1] = n .. &quot;=&quot; .. tostring(c.Value) end&lt;br/&gt;  end&lt;br/&gt;  logText(&quot;  cond &quot; .. table.concat(parts, &quot; &quot;))&lt;br/&gt;  if text then&lt;br/&gt;    local dur = 1300 + #body * 28&lt;br/&gt;    if dur &gt; 5200 then dur = 5200 end&lt;br/&gt;    if dur &lt; 1500 then dur = 1500 end&lt;br/&gt;    text.TimeToWait = dur&lt;br/&gt;  end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;function nagasakiTextStopped(text)&lt;br/&gt;  local id = &quot;?&quot;&lt;br/&gt;  if text and text.getId then&lt;br/&gt;    local tid = text:getId()&lt;br/&gt;    if tid then id = tostring(tid.id) end&lt;br/&gt;  end&lt;br/&gt;  logText(string.format(&quot;%.2f textStopped id=%s&quot;, os.clock(), id))&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;registerEventHandler(&quot;textStarted&quot;, &quot;nagasakiTextStarted&quot;)&lt;br/&gt;registerEventHandler(&quot;textStopped&quot;, &quot;nagasakiTextStopped&quot;)&lt;br/&gt;&lt;br/&gt;function nagasakiCursor()&lt;br/&gt;  if not cursorSprite then&lt;br/&gt;    cursorSprite = graphics.loadFromFile(&quot;vispath:graphics/cursor_arrow.png&quot;)&lt;br/&gt;  end&lt;br/&gt;  if cursorSprite then&lt;br/&gt;    local p = getCursorPos()&lt;br/&gt;    cursorSprite.position = {x = p.x - 8, y = p.y - 6}&lt;br/&gt;    graphics.drawSprite(cursorSprite, 1.0)&lt;br/&gt;  end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;graphics.addDrawFunc(&quot;nagasakiCursor()&quot;, 1)" ScriptType="1" />
	</Scripts>
