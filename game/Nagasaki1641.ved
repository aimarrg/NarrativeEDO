			<TextTextLanguages>
				<text Text="Red de pesca" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_barco" id="13" order="13" lastModified="-1">
			<TextTextLanguages>
				<text Text="Barco holandés" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_cajas" id="14" order="14" lastModified="-1">
			<TextTextLanguages>
				<text Text="Cajas del muelle" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_continuar" id="15" order="15" lastModified="-1">
			<TextTextLanguages>
				<text Text="Continuar" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_menu" id="16" order="16" lastModified="-1">
			<TextTextLanguages>
				<text Text="Menú principal" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_salir" id="17" order="17" lastModified="-1">
			<TextTextLanguages>
				<text Text="Salir" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_nueva" id="18" order="18" lastModified="-1">
			<TextTextLanguages>
				<text Text="Nueva partida" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="n_abandonar" id="19" order="19" lastModified="-1">
			<TextTextLanguages>
				<text Text="Salir del juego" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="haru" id="20" order="20" lastModified="-1">
			<TextTextLanguages>
				<text Text="Haru" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_1" id="21" order="21" lastModified="-1">
			<TextTextLanguages>
				<text Text="Castillo del Shogun. Amanecer del décimo día del octavo mes." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_2" id="22" order="22" lastModified="-1">
			<TextTextLanguages>
				<text Text="El patio huele a tierra mojada. Nadie habla." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_3" id="23" order="23" lastModified="-1">
			<TextTextLanguages>
				<text Text="Haru espera de rodillas junto al cepo. Las manos le tiemblan detrás de la espalda." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_4" id="24" order="24" lastModified="-1">
			<TextTextLanguages>
				<text Text="«Haru, hijo de comerciantes de Nagasaki: acusado de tratar con extranjeros.»" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_5" id="25" order="25" lastModified="-1">
			<TextTextLanguages>
				<text Text="La multitud contiene el aliento. El verdugo comprueba la cuerda." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_6" id="26" order="26" lastModified="-1">
			<TextTextLanguages>
				<text Text="La hoja sube. Un instante de silencio." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_7" id="27" order="27" lastModified="-1">
			<TextTextLanguages>
				<text Text="El filo cae." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_8" id="28" order="28" lastModified="-1">
			<TextTextLanguages>
				<text Text="Y todo se apaga." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="castillo_9" id="29" order="29" lastModified="-1">
			<TextTextLanguages>
				<text Text="Despiertas en tu casa. Aún es de noche y todo sigue en su sitio." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="foto" id="30" order="30" lastModified="-1">
			<TextTextLanguages>
				<text Text="Tu familia, retratada el año del incendio. Tu madre sostiene el abanico que aún guardas; tu padre finge no sonreír." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="nota" id="31" order="31" lastModified="-1">
			<TextTextLanguages>
				<text Text="«Haru: si lees esto, es que ya eres el hombre de la casa. Te quiero más de lo que supe decirte. Cuida el negocio y cuídate tú. — Tu padre»" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="taberna_cerrada" id="32" order="32" lastModified="-1">
			<TextTextLanguages>
				<text Text="La puerta está cerrada con una cuerda y un cartel: «Cerrado hasta la noche»." path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="taberna_abierta" id="33" order="33" lastModified="-1">
			<TextTextLanguages>
				<text Text="(Aquí irá tu diálogo de la taberna.)" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="pescador" id="34" order="34" lastModified="-1">
			<TextTextLanguages>
				<text Text="(Aquí irá tu diálogo con el pescador.)" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="red" id="35" order="35" lastModified="-1">
			<TextTextLanguages>
				<text Text="(Aquí irá el texto de la red de pesca.)" path="" int="0" />
			</TextTextLanguages>
		</Text>
		<Text name="barco" id="36" order="36" lastModified="-1">
			<TextTextLanguages>
				<text Text="(Aquí irá el texto del barco holandés.)" path="" int="0" />
			</TextTextLanguages>
		</Text>
