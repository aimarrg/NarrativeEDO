	<Texts newId="49" versionedId="-1" tableId="14">
		<Text name="Id: 0 - Inicio del mercado: Diálogo" id="0" order="0" lastModified="-1">
			<TextTextLanguages>
				<text Text="Nagasaki, 1641. El shogunato Tokugawa ha cerrado Japón al mundo. Solo Dejima, una isla artificial en el puerto, sigue abierta al comercio." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 1 - Inicio del mercado: Diálogo" id="1" order="1" lastModified="-1">
			<TextTextLanguages>
				<text Text="Has heredado el negocio de tu padre. Hoy debes entregar un cargamento en el almacén del puerto... y cobrar antes del anochecer." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 2 - Inicio del mercado: Diálogo" id="2" order="2" lastModified="-1">
			<TextTextLanguages>
				<text Text="Habla con el pescador, consigue pasar al guardia y revisa la caja. El sello del gremio es la llave." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 3 - fisher: Pescador" id="3" order="3" lastModified="-1">
			<TextTextLanguages>
				<text Text="Pescador: «Los barcos holandeses descargan de noche. Anoche vi linternas en el almacén viejo... y gente que no debía estar ahí.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 4 - fisher: Pescador" id="4" order="4" lastModified="-1">
			<TextTextLanguages>
				<text Text="Pescador: «El guardia lleva desde el amanecer con el estómago vacío. Ofrécele algo de comer y quizá te deje registrar la caja.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 5 - fish: Coger pescado" id="5" order="5" lastModified="-1">
			<TextTextLanguages>
				<text Text="Coges un pescado seco del puesto. Huele fatal, pero es comida." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 6 - guard: Guardia" id="6" order="6" lastModified="-1">
			<TextTextLanguages>
				<text Text="Guardia: «Alto. Sin el sello del gremio no se pasa al almacén.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 7 - guard: Guardia" id="7" order="7" lastModified="-1">
			<TextTextLanguages>
				<text Text="Guardia: «¿Eso es pescado? ... Bueno. El deber puede esperar un momento.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 8 - guard: Guardia" id="8" order="8" lastModified="-1">
			<TextTextLanguages>
				<text Text="El guardia mastica feliz, mirando al mar. La caja queda a tu alcance." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 9 - : " id="9" order="9" lastModified="-1">
			<TextTextLanguages>
				<text Text="Guardia: «Ese sello está en regla. El inspector te espera dentro.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 10 - crate: Caja" id="10" order="10" lastModified="-1">
			<TextTextLanguages>
				<text Text="El guardia no te quita ojo. Registrar la caja ahora sería una mala idea." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 11 - crate: Caja" id="11" order="11" lastModified="-1">
			<TextTextLanguages>
				<text Text="Bajo la lona hay un sello de madera del gremio de comerciantes. Sin él, el guardia no te dejará pasar." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 12 - crate: Caja" id="12" order="12" lastModified="-1">
			<TextTextLanguages>
				<text Text="La caja está vacía. Solo queda la marca del sello en el polvo." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 13 - edict: Edicto" id="13" order="13" lastModified="-1">
			<TextTextLanguages>
				<text Text="Edicto del shogun: «Ningún japonés abandonará el país. Ningún extranjero entrará sin permiso. El que ayude a un fugitivo será castigado.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 14 - door: Puerta del almacén" id="14" order="14" lastModified="-1">
			<TextTextLanguages>
				<text Text="El guardia bloquea la puerta con la lanza. No piensas insistir." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 15 - door: Puerta del almacén" id="15" order="15" lastModified="-1">
			<TextTextLanguages>
				<text Text="Empujas la puerta corredera. Dentro huele a madera húmeda y a especias." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 16 - merchant: Mercader" id="16" order="16" lastModified="-1">
			<TextTextLanguages>
				<text Text="Mercader holandés: «Ah, el joven Haru. Tu padre y yo teníamos un acuerdo. La mercancía está abajo... y también tres polizones.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 17 - Inicio del almacén: Diálogo" id="17" order="17" lastModified="-1">
			<TextTextLanguages>
				<text Text="Mercader holandés: «Nadie tiene que saberlo. Tú cobras, yo desaparezco. ¿Qué dices?»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 18 - merchant: Mercader" id="18" order="18" lastModified="-1">
			<TextTextLanguages>
				<text Text="Mercader holandés: «Piénsalo. Denunciarme te dará una medalla; ayudarme, una fortuna. O puedes callar y seguir cobrando.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 19 - hidden: Fugitivo" id="19" order="19" lastModified="-1">
			<TextTextLanguages>
				<text Text="Fugitivo: «Nos esconden en cajas. Si nos encuentran, nos matan. Por favor... tú no eres como ellos.»" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 20 - sack: Saco" id="20" order="20" lastModified="-1">
			<TextTextLanguages>
				<text Text="Un saco de seda con el sello del inspector. Alguien está cobrando por dejar pasar mercancía prohibida." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 21 - sack: Saco" id="21" order="21" lastModified="-1">
			<TextTextLanguages>
				<text Text="El saco ya no guarda nada. Solo queda el sello del inspector grabado en la etiqueta." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 22 - plaque_denounce: Denunciar" id="22" order="22" lastModified="-1">
			<TextTextLanguages>
				<text Text="Sin una prueba, el inspector se reirá de ti. Registra el almacén antes de denunciar." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 23 - plaque_help: Ayudar" id="23" order="23" lastModified="-1">
			<TextTextLanguages>
				<text Text="No sabes quiénes son ni adónde irían. Habla antes con el fugitivo." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 24 - plaque_denounce: Denunciar" id="24" order="24" lastModified="-1">
			<TextTextLanguages>
				<text Text="Cierras la puerta y corres a la oficina de inspección. Al amanecer, el almacén está rodeado de guardias." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 25 - plaque_help: Ayudar" id="25" order="25" lastModified="-1">
			<TextTextLanguages>
				<text Text="Abres la trampilla del muelle. Los tres fugitivos escapan en la barca del pescador antes de que cante el gallo." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 26 - plaque_silent: Callar" id="26" order="26" lastModified="-1">
			<TextTextLanguages>
				<text Text="No haces nada. El cargamento se descarga y el dinero cambia de manos. El mar se lo traga todo." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 27 - Inicio del epílogo: Diálogo" id="27" order="27" lastModified="-1">
			<TextTextLanguages>
				<text Text="El inspector es detenido y el mercader holandés expulsado de Dejima. Tu negocio sobrevive, pero el puerto te mira con recelo. Has elegido la ley." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 28 - Inicio del epílogo: Diálogo" id="28" order="28" lastModified="-1">
			<TextTextLanguages>
				<text Text="Al amanecer, la barca es solo un punto en el horizonte. Pierdes el cargamento y la mitad de tu fortuna... pero nadie muere esa noche. Has elegido a las personas." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 29 - Inicio del epílogo: Diálogo" id="29" order="29" lastModified="-1">
			<TextTextLanguages>
				<text Text="No haces nada. El cargamento se descarga y el dinero cambia de manos. La historia no recordará tu nombre." path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 30 - Inicio del epílogo: Diálogo" id="30" order="30" lastModified="-1">
			<TextTextLanguages>
				<text Text="FIN" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 31 - epilogue: plaque_replay" id="31" order="31" lastModified="-1">
			<TextTextLanguages>
				<text Text="Volver a jugar" path="" int="0"/>
			</TextTextLanguages>
		</Text>
		<Text name="Id: 32 - Ir a merchant: merchant" id="32" order="32" lastModified="-1">
